{
  "name": "antigravity-recorder",
  "version": "1.0.0",
  "description": "Grabador local sincronizado con TTS para trazabilidad automática de casos de prueba",
  "main": "main.js",
  "author": "ATC Team",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable",
    "build:win:installer": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:all": "electron-builder --win portable --linux AppImage deb"
  },
  "build": {
    "appId": "com.antigravity.recorder",
    "productName": "Antigravity Recorder",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "src"
      },
      {
        "from": "../main.py",
        "to": "main.py"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../.env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "appImage": {
      "systemIntegration": "doNotAsk"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  }
}
