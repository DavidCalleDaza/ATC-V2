.video-player-container {
  background: #000;
  border-radius: 8px;
  border: 1px solid var(--border-color);
  overflow: hidden;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-placeholder {
  color: #8b949e;
  font-size: 16px;
  padding: 80px 20px;
  text-align: center;
}

